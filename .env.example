# GLAMSTEP — Environment Variables Configuration

# Supabase Database & Auth Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Nodemailer SMTP Email Configuration (for OTP & Notifications)
# For Gmail: Use 'smtp.gmail.com', port 465 or 587, and an 'App Password'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME="GLAMSTEP Luxury"
SMTP_FROM=your-email@gmail.com

# Razorpay Indian Payment Gateway Configuration
# Get these from Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Store Configuration
NEXT_PUBLIC_STORE_NAME=GLAMSTEP
NEXT_PUBLIC_STORE_URL=https://glamstep.luxury
NEXT_PUBLIC_SUPPORT_EMAIL=concierge@glamstep.luxury
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=2499
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR

# Admin Access Passkey (Default demo admin: admin@glamstep.luxury / luxury2025)
ADMIN_SECRET_TOKEN=glamstep_admin_super_secret_token_2025
